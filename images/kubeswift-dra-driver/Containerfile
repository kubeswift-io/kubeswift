# Multi-stage build for kubeswift-dra-driver (the reference DRA GPU driver).
FROM golang:1.27-bookworm@sha256:21ade014faf952365b9ecbd8dbdb87176fbacb82fac9fb132d9f2a7b8cc3f132 AS builder
WORKDIR /build

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

COPY go.mod go.sum ./
RUN go mod download
COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-X github.com/kubeswift-io/kubeswift/internal/version.Version=${VERSION} -X github.com/kubeswift-io/kubeswift/internal/version.GitCommit=${GIT_COMMIT} -X github.com/kubeswift-io/kubeswift/internal/version.BuildDate=${BUILD_DATE}" \
    -o kubeswift-dra-driver ./cmd/kubeswift-dra-driver

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
ARG VERSION=dev
ARG GIT_COMMIT=unknown
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT}"
# Patch base-layer packages. This image installs nothing of its own, so every
# package in it comes from debian:bookworm-slim -- and a CVE fixed in Debian but
# not yet rebuilt into that tag would otherwise ship here untouched. That is how
# CVE-2026-86145 and CVE-2026-89161 (libpcre2-8-0 10.42-1, fixed in
# 10.42-1+deb12u1) failed the nightly scan: upstream still ships the vulnerable
# build. Installing no packages is not the same as having no packages.
RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/kubeswift-dra-driver /kubeswift-dra-driver
# Runs as root: the kubelet plugin sockets (/var/lib/kubelet/plugins*) and the
# CDI dir (/var/run/cdi) are root-owned host paths. Capabilities are dropped in
# the DaemonSet securityContext; no privileged mode is needed (pure sysfs reads
# + unix sockets + file writes).
ENTRYPOINT ["/kubeswift-dra-driver"]
