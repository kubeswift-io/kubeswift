# Multi-stage build for gpu-discovery
FROM golang:1.27-bookworm AS builder
WORKDIR /build

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

# Copy module files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source
COPY . .

# Build gpu-discovery with version stamping
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-X github.com/kubeswift-io/kubeswift/internal/version.Version=${VERSION} -X github.com/kubeswift-io/kubeswift/internal/version.GitCommit=${GIT_COMMIT} -X github.com/kubeswift-io/kubeswift/internal/version.BuildDate=${BUILD_DATE}" \
    -o gpu-discovery ./cmd/gpu-discovery

# Runtime stage — needs pciutils (lspci) and util-linux (lscpu)
FROM debian:bookworm-slim
ARG VERSION=dev
ARG GIT_COMMIT=unknown
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT}"
# Patch base-layer packages. `apt-get install` only resolves the packages named
# below -- it never upgrades what the base image already ships, so a CVE fixed
# in Debian but not yet rebuilt into debian:bookworm-slim stays in the image
# forever. That is exactly how CVE-2026-86145 and CVE-2026-89161 (libpcre2-8-0
# 10.42-1, fixed in 10.42-1+deb12u1) failed the nightly scan on all six
# Debian-based images: upstream still ships the vulnerable build, and the fix is
# only an `apt-get upgrade` away. Do not drop this line to make builds more
# reproducible -- rebuilding without it re-ships the vulnerability.
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
    pciutils \
    && rm -rf /var/lib/apt/lists/*
# lscpu is part of util-linux which is included in bookworm-slim by default.
COPY --from=builder /build/gpu-discovery /gpu-discovery
USER 65534:65534
ENTRYPOINT ["/gpu-discovery"]
