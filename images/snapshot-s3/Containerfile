# Multi-stage build for snapshot-s3 (Tier C object-storage uploader/downloader)
FROM golang:1.27-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195 AS builder
WORKDIR /build

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

# Copy module files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source
COPY . .

# Build snapshot-s3 with version stamping (static — pure-Go minio-go, no cgo)
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-X github.com/kubeswift-io/kubeswift/internal/version.Version=${VERSION} -X github.com/kubeswift-io/kubeswift/internal/version.GitCommit=${GIT_COMMIT} -X github.com/kubeswift-io/kubeswift/internal/version.BuildDate=${BUILD_DATE}" \
    -o snapshot-s3 ./cmd/snapshot-s3

# Runtime stage — needs CA certificates for TLS to S3/MinIO; nothing else.
FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
ARG VERSION=dev
ARG GIT_COMMIT=unknown
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT}"
# Patch base-layer packages. `apt-get install` only resolves the packages named
# below -- it never upgrades what the base image already ships, so a CVE fixed
# in Debian but not yet rebuilt into debian:bookworm-slim stays in the image
# forever. That is exactly how CVE-2026-86145 and CVE-2026-89161 (libpcre2-8-0
# 10.42-1, fixed in 10.42-1+deb12u1) failed the nightly scan on all six
# Debian-based images: upstream still ships the vulnerable build, and the fix is
# only an `apt-get upgrade` away. Do not drop this line to make builds more
# reproducible -- rebuilding without it re-ships the vulnerability.
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/snapshot-s3 /snapshot-s3
USER 65534:65534
ENTRYPOINT ["/snapshot-s3"]
